#!/usr/bin/env bash
# webbot — visual web-app QA driven by Claude Code + Playwright MCP.
#
# Subcommands:
#   install                     One-shot install of all deps + PATH symlink
#   init <url-or-project-dir>   Configure the target app, run flow discovery
#   auth                        Capture login state into .webbot/storage-state.json
#   creds [add|list|clear]      Manage stored test logins + tester preferences
#   run                         Re-run discovered flows + critique + HTML report
#   go                          Alias for run (+ notification + open report)
#   flow <flow-file.md>         Execute a user-authored test plan
#   doctor                      Verify environment
#   help                        Show this
#
# Run from inside the target app's repo (or any dir for a deployed URL). webbot
# writes its state under `./.webbot/`.

set -euo pipefail

# Resolve this script's real path, following symlinks (e.g. /usr/local/bin/webbot
# → ~/.webbot/web/bin/webbot), so WEBBOT_HOME points at the real checkout. macOS
# bash 3.2 has no `readlink -f`, so walk the symlink chain by hand.
_webbot_src="${BASH_SOURCE[0]}"
while [ -h "$_webbot_src" ]; do
  _webbot_dir="$(cd -P "$(dirname "$_webbot_src")" && pwd)"
  _webbot_src="$(readlink "$_webbot_src")"
  [ "${_webbot_src#/}" = "$_webbot_src" ] && _webbot_src="$_webbot_dir/$_webbot_src"
done
WEBBOT_HOME="$(cd -P "$(dirname "$_webbot_src")/.." && pwd)"
unset _webbot_src _webbot_dir
source "$WEBBOT_HOME/src/lib/app.sh"
source "$WEBBOT_HOME/src/lib/browser.sh"
source "$WEBBOT_HOME/src/lib/claude.sh"
source "$WEBBOT_HOME/src/lib/notify.sh"
source "$WEBBOT_HOME/src/lib/install.sh"
source "$WEBBOT_HOME/src/lib/setup.sh"
source "$WEBBOT_HOME/src/lib/audio.sh"

# Set by the dispatcher from a global `--work-dir <dir>` flag (or WEBBOT_WORK_DIR env).
# When set, commands operate on <dir>/.webbot instead of the current directory.
WEBBOT_WORK_DIR="${WEBBOT_WORK_DIR:-}"

webbot_set_dirs() { WEBBOT_DIR="$PWD/.webbot"; CONFIG_FILE="$WEBBOT_DIR/config.json"; }

# cd into the directory whose .webbot/ this run should use, announcing the move when it
# differs from $PWD. An explicit --work-dir / WEBBOT_WORK_DIR always wins; else the
# caller's default. Re-derives WEBBOT_DIR/CONFIG_FILE so all relative state follows.
# Args: <default-work-dir>
webbot_enter_work_dir() {
  local target="${WEBBOT_WORK_DIR:-$1}"
  [ -z "$target" ] && target="$PWD"
  mkdir -p "$target"
  target="$(cd "$target" && pwd)"
  if [ "$target" != "$PWD" ]; then
    echo ">> webbot state dir: $target/.webbot (use --work-dir to override)" >&2
    cd "$target"
  fi
  webbot_set_dirs
}

webbot_set_dirs

usage() {
  cat <<EOF
webbot — visual web-app QA driven by Claude Code + Playwright MCP

Usage:
  webbot install                     One-shot install of all deps
  webbot init <url-or-project-dir>   Configure target + discover flows
  webbot auth                        Capture login state (manual login, saved for runs)
  webbot creds [add|list|clear]      Manage stored test logins + tester preferences
  webbot run                         Re-run discovered flows + report
  webbot go                          run + notification + open report
  webbot flow <flow-file.md>         Execute a custom test plan
  webbot design [<figma-link>]       Compare screens against their Figma frames (needs Figma MCP)
  webbot setup-audio                 Install BlackHole + switchaudio-osx (macOS; voice tests)
  webbot audio [status|on|off|restore]  Show / toggle / restore mic routing
  webbot speak <phrase>              TTS + play (feeds the browser mic via loopback)
  webbot doctor                      Verify environment
  webbot help

<url-or-project-dir> may be:
  https://staging.myapp.com          (deployed app)
  http://localhost:3000              (already-running dev server)
  /path/to/my-app                    (local project — dev server auto-started)

Options (append to any subcommand):
  --work-dir <dir>        Put .webbot/ under <dir> instead of the current directory.
                          (init auto-anchors to a local project's own directory.)

Env:
  WEBBOT_APP_URL          URL a local project serves on (default: http://localhost:3000)
  WEBBOT_CLAUDE_MODEL     Claude model (default: claude-opus-4-8)
  WEBBOT_WORK_DIR         Same as --work-dir
  WEBBOT_FIGMA_MCP_URL    Figma MCP transport for 'design' (default: http://127.0.0.1:3845/mcp)
  WEBBOT_TTS_VOICE        macOS `say` voice for voice tests (default: Samantha)
  WEBBOT_HEADLESS=1       Run the browser headless
  WEBBOT_TRACE=1          Enable devtools caps (Playwright tracing tools) for the agent
  WEBBOT_TIMEOUT_SECONDS  Wall-clock kill for the agent (default: 900)
  WEBBOT_MAX_BUDGET_USD   Spend cap for the agent (default: 3)
EOF
}

# --- config helpers ---------------------------------------------------------

config_get() {
  local key="$1"
  /usr/bin/python3 -c "
import json, sys
try:
    print(json.load(open(sys.argv[1])).get(sys.argv[2], ''))
except Exception:
    pass
" "$CONFIG_FILE" "$key" 2>/dev/null || true
}

config_require() {
  if [ ! -f "$CONFIG_FILE" ]; then
    echo "ERR: no $CONFIG_FILE — run 'webbot init <url-or-project-dir>' first." >&2
    exit 1
  fi
}

# --- pass runner -------------------------------------------------------------
# Boots the app (if local), wires Playwright MCP, composes the prompt, spawns
# claude, and refreshes the latest-report symlink.
# Args: <pass-prompt-file> [flow-file] [with-figma-0/1]
run_pass() {
  local pass_prompt="$1" flow_file="${2:-}" with_figma="${3:-0}"

  local app_url dev_command dev_dir storage_state figma_file
  app_url=$(config_get app_url)
  dev_command=$(config_get dev_command)
  dev_dir=$(config_get dev_dir)
  storage_state=$(config_get storage_state)
  figma_file=$(config_get figma_file)
  [ -n "$app_url" ] || { echo "ERR: app_url missing from $CONFIG_FILE" >&2; exit 1; }

  local run_id run_dir
  run_id=$(date +%Y-%m-%d-%H%M%S)
  run_dir="$WEBBOT_DIR/reports/$run_id"
  mkdir -p "$run_dir/screenshots"
  # Pre-seed the journals so the agent's first append always works.
  touch "$run_dir/journal.jsonl" "$run_dir/flaws.jsonl" "$run_dir/critique.jsonl"
  # Design pass: seed its journal + the Figma-render dir too.
  if [ "$with_figma" = 1 ]; then
    mkdir -p "$run_dir/design"
    touch "$run_dir/design-diffs.jsonl"
  fi

  # If the flows involve voice (mic/dictation/getUserMedia), route the host mic to
  # BlackHole for the run and grant the browser mic permission. Devices are ALWAYS
  # restored afterward — even on crash/timeout/Ctrl-C (the cleanup trap).
  local voice=0 grant_mic=0
  local -a _vfiles=("$WEBBOT_DIR/CLAUDE.md"); [ -n "$flow_file" ] && _vfiles+=("$flow_file")
  if grep -qiE 'voice|microphone|dictation|speech|getusermedia|record audio|audio call|hold to talk|(^|[^a-zA-Z])mic([^a-zA-Z]|$)' \
       "${_vfiles[@]}" 2>/dev/null; then voice=1; fi

  _webbot_cleanup() { app_stop; [ "${voice:-0}" = 1 ] && { audio_restore >/dev/null 2>&1 || true; }; }
  trap _webbot_cleanup EXIT INT TERM
  app_start "$dev_command" "$dev_dir" "$app_url" "$run_dir"

  if [ "$voice" = 1 ] && command -v SwitchAudioSource >/dev/null 2>&1; then
    audio_meeting_warning
    if audio_enter_test_mode; then grant_mic=1; fi
  fi

  local mcp_config ctx prompt
  mcp_config=$(mktemp -t webbot-mcp)
  browser_write_mcp_config "$mcp_config" "$run_dir" "$storage_state" "$grant_mic" "$with_figma"
  ctx=$(mktemp -t webbot-ctx)
  local auth_block; auth_block=$(config_auth_block "$CONFIG_FILE")
  claude_write_run_context "$ctx" "$app_url" "$run_dir" "$WEBBOT_DIR" "$flow_file" "$auth_block" "$with_figma" "$figma_file"
  prompt=$(claude_compose_prompt "$pass_prompt" "$ctx")

  echo ">> Spawning Claude (model: ${WEBBOT_CLAUDE_MODEL:-claude-opus-4-8}) — run dir: $run_dir" >&2
  claude_run "$prompt" "$mcp_config" "$PWD" || true

  rm -f "$prompt" "$ctx" "$mcp_config"
  [ "$voice" = 1 ] && { audio_restore || true; }
  app_stop
  trap - EXIT INT TERM

  # Playwright MCP sometimes resolves screenshot filenames against the process cwd
  # instead of --output-dir. Sweep strays (only PNGs newer than this run) into the
  # run's screenshots dir so journal references (screenshots/<name>) always resolve.
  find "$PWD" -maxdepth 1 -name "*.png" -newer "$run_dir" \
    -exec mv {} "$run_dir/screenshots/" \; 2>/dev/null || true

  ln -sfn "$run_dir" "$WEBBOT_DIR/reports/latest"
  LAST_RUN_DIR="$run_dir"
}

flaw_count() {
  local f="$1"
  [ -f "$f" ] && grep -c . "$f" 2>/dev/null || echo 0
}

# --- subcommands -------------------------------------------------------------

cmd_init() {
  local target="${1:-}"
  [ -n "$target" ] || { echo "ERR: webbot init <url-or-project-dir>" >&2; exit 1; }

  local app_url="" dev_command="" dev_dir=""
  case "$target" in
    http://*|https://*)
      webbot_enter_work_dir "$PWD"   # deployed URL: no source dir, anchor to cwd (or --work-dir)
      app_url="$target"
      ;;
    *)
      [ -d "$target" ] || { echo "ERR: $target is neither a URL nor a directory" >&2; exit 1; }
      dev_dir="$(cd "$target" && pwd)"
      webbot_enter_work_dir "$dev_dir"   # local project: anchor .webbot/ to the app's own dir
      dev_command=$(app_detect_dev_command "$dev_dir")
      app_url="${WEBBOT_APP_URL:-http://localhost:3000}"
      if [ -z "$dev_command" ]; then
        echo "WARN: couldn't detect a dev command in $dev_dir." >&2
        echo "      Start the app yourself before runs, or add dev_command to $CONFIG_FILE." >&2
      else
        echo ">> Detected dev command: $dev_command (serving at $app_url — override with WEBBOT_APP_URL)" >&2
      fi
      ;;
  esac

  mkdir -p "$WEBBOT_DIR/reports"
  cat > "$CONFIG_FILE" <<EOF
{
  "app_url": "$app_url",
  "dev_command": "$dev_command",
  "dev_dir": "$dev_dir",
  "storage_state": "",
  "figma_file": "",
  "credentials": [],
  "preferences": ""
}
EOF

  # Ask for login(s) + tester preferences and persist them to config.json. Captured
  # once, reused by every run (the agent types them into the app's own forms). Doing
  # this BEFORE discovery means discovery can sign in and map the gated app too.
  setup_credentials "$CONFIG_FILE"
  # Per-app rubric copy — users extend it; runs read this copy, not the template.
  [ -f "$WEBBOT_DIR/critique-rubric.md" ] || cp "$WEBBOT_HOME/src/templates/critique-rubric.md" "$WEBBOT_DIR/critique-rubric.md"
  # Empty state graph for discovery to fill.
  [ -f "$WEBBOT_DIR/state-graph.json" ] || echo '{"nodes": [], "edges": []}' > "$WEBBOT_DIR/state-graph.json"

  echo ">> Config written to $CONFIG_FILE — starting discovery." >&2
  run_pass "$WEBBOT_HOME/src/templates/discover-prompt.md"
  echo ""
  echo ">> Discovery done. Review/edit the proposed flows in $WEBBOT_DIR/CLAUDE.md, then: webbot run"
}

cmd_auth() {
  webbot_enter_work_dir "$PWD"
  config_require
  local app_url; app_url=$(config_get app_url)
  browser_capture_auth "$app_url" "$WEBBOT_DIR/storage-state.json"
  /usr/bin/python3 -c "
import json, sys
cfg = json.load(open(sys.argv[1]))
cfg['storage_state'] = sys.argv[2]
json.dump(cfg, open(sys.argv[1], 'w'), indent=2)
" "$CONFIG_FILE" "$WEBBOT_DIR/storage-state.json"
}

# Manage the persistent credential list + tester preferences in config.json.
cmd_creds() {
  webbot_enter_work_dir "$PWD"
  config_require
  case "${1:-list}" in
    add)
      # Interactive (or env-seeded) add of one-or-more logins + preferences.
      setup_credentials "$CONFIG_FILE"
      echo; setup_show "$CONFIG_FILE"
      ;;
    list|show|"")
      setup_show "$CONFIG_FILE"
      ;;
    clear)
      /usr/bin/python3 -c "
import json, sys
cfg = json.load(open(sys.argv[1]))
cfg['credentials'] = []; cfg['preferences'] = ''
json.dump(cfg, open(sys.argv[1], 'w'), indent=2)
" "$CONFIG_FILE"
      echo ">> Cleared stored credentials + preferences." >&2
      ;;
    *) echo "ERR: webbot creds [add|list|clear]" >&2; exit 1 ;;
  esac
}

cmd_run() {
  webbot_enter_work_dir "$PWD"
  config_require
  if [ ! -f "$WEBBOT_DIR/CLAUDE.md" ]; then
    echo "ERR: no $WEBBOT_DIR/CLAUDE.md (no discovered flows) — run 'webbot init' first." >&2
    exit 1
  fi
  run_pass "$WEBBOT_HOME/src/templates/run-prompt.md"
  local flaws; flaws=$(flaw_count "$LAST_RUN_DIR/flaws.jsonl")
  notify_user "webbot" "Run complete — $flaws flaw(s) recorded"
  notify_open_report "$LAST_RUN_DIR/report.html"
  echo ">> Report: $LAST_RUN_DIR/report.html"
}

cmd_flow() {
  local flow_file="${1:-}"
  [ -f "$flow_file" ] || { echo "ERR: webbot flow <flow-file.md>" >&2; exit 1; }
  flow_file="$(cd "$(dirname "$flow_file")" && pwd)/$(basename "$flow_file")"
  webbot_enter_work_dir "$PWD"
  config_require
  run_pass "$WEBBOT_HOME/src/templates/flow-prompt.md" "$flow_file"
  local flaws; flaws=$(flaw_count "$LAST_RUN_DIR/flaws.jsonl")
  notify_user "webbot" "Flow complete — $flaws flaw(s) recorded"
  notify_open_report "$LAST_RUN_DIR/report.html"
  echo ">> Report: $LAST_RUN_DIR/report.html"
}

# Design-fidelity pass: compare implemented screens against their Figma frames.
# Optional arg: a Figma file link/key to persist into config.json (figma_file). Otherwise
# uses the stored figma_file, or the frame currently selected in the open Figma desktop app.
cmd_design() {
  webbot_enter_work_dir "$PWD"
  config_require
  local figma_link="${1:-}"
  if [ -n "$figma_link" ]; then
    /usr/bin/python3 -c "
import json, sys
cfg = json.load(open(sys.argv[1]))
cfg['figma_file'] = sys.argv[2]
json.dump(cfg, open(sys.argv[1], 'w'), indent=2)
" "$CONFIG_FILE" "$figma_link"
    echo ">> Stored figma_file: $figma_link" >&2
  fi
  if ! figma_mcp_reachable; then
    echo "WARN: Figma MCP not reachable at ${WEBBOT_FIGMA_MCP_URL:-http://127.0.0.1:3845/mcp}." >&2
    echo "      Open the Figma desktop app, press Shift-D, and 'Enable desktop MCP server'" >&2
    echo "      (or set WEBBOT_FIGMA_MCP_URL). Continuing anyway — the pass needs it." >&2
  fi
  # A persisted design-map.json lets re-runs skip auto-pairing; seed an empty one so the
  # agent always has a file to read and fill.
  [ -f "$WEBBOT_DIR/design-map.json" ] || echo '{"figma_file": "", "screens": []}' > "$WEBBOT_DIR/design-map.json"
  run_pass "$WEBBOT_HOME/src/templates/design-prompt.md" "" 1
  local diffs; diffs=$(flaw_count "$LAST_RUN_DIR/design-diffs.jsonl")
  notify_user "webbot" "Design check complete — $diffs deviation(s) recorded"
  notify_open_report "$LAST_RUN_DIR/design-report.html"
  echo ">> Report: $LAST_RUN_DIR/design-report.html"
}

cmd_doctor() {
  webbot_enter_work_dir "$PWD"
  local ok=1
  for bin in node npx claude curl /usr/bin/python3; do
    if command -v "$bin" >/dev/null 2>&1; then
      echo "ok   $bin"
    else
      echo "MISS $bin"; ok=0
    fi
  done
  if npx -y playwright --version >/dev/null 2>&1; then
    echo "ok   playwright"
  else
    echo "MISS playwright — run: webbot install"; ok=0
  fi
  # Audio loopback is informational (only voice-input flows need it).
  audio_doctor || true
  # Figma MCP is informational (only the design pass needs it).
  if figma_mcp_reachable; then
    echo "ok   figma MCP (${WEBBOT_FIGMA_MCP_URL:-http://127.0.0.1:3845/mcp})"
  else
    echo "note figma MCP unreachable — for 'webbot design', enable it in Figma desktop (Shift-D)"
  fi
  if [ -f "$CONFIG_FILE" ]; then
    echo "ok   $CONFIG_FILE (app: $(config_get app_url))"
    local ss; ss=$(config_get storage_state)
    if [ -n "$ss" ] && [ -f "$ss" ]; then
      echo "ok   auth storage-state"
    else
      echo "note no auth captured — 'webbot auth' if the app needs login"
    fi
  else
    echo "note not initialized here — 'webbot init <url-or-project-dir>'"
  fi
  [ "$ok" = 1 ] && echo "all good." || { echo "missing tools above."; exit 1; }
}

# --- audio (voice-input testing) ---------------------------------------------

cmd_setup_audio() { audio_install_loopback; }

cmd_speak() {
  local phrase="${1:-}"
  [ -n "$phrase" ] || { echo "ERR: webbot speak <phrase>" >&2; exit 1; }
  audio_speak "$phrase"
}

cmd_tts() {
  local phrase="${1:-}" out_path="${2:-}"
  [ -n "$phrase" ] || { echo "ERR: webbot tts <phrase> [out.aiff]" >&2; exit 1; }
  local file; file=$(audio_synthesize "$phrase")
  if [ -n "$out_path" ]; then mv "$file" "$out_path"; echo "$out_path"; else echo "$file"; fi
}

cmd_audio() {
  case "${1:-status}" in
    status)      audio_status ;;
    save)        audio_save && echo "audio: saved current devices" >&2 ;;
    on)          audio_meeting_warning; audio_enter_test_mode ;;
    off|restore) audio_restore || echo "audio: nothing to restore (no saved state)" >&2 ;;
    *) echo "usage: webbot audio [status|on|off|save|restore]" >&2; exit 1 ;;
  esac
}

# --- dispatch ----------------------------------------------------------------

# Pull a global `--work-dir <dir>` (or --work-dir=<dir>) out of the args, wherever it
# appears, so any subcommand can be redirected to another directory.
SUB="${1:-help}"; shift || true
REST=()
while [ $# -gt 0 ]; do
  case "$1" in
    --work-dir)   WEBBOT_WORK_DIR="${2:-}"; shift 2 || shift ;;
    --work-dir=*) WEBBOT_WORK_DIR="${1#*=}"; shift ;;
    *)            REST+=("$1"); shift ;;
  esac
done
set -- ${REST[@]+"${REST[@]}"}

case "$SUB" in
  install) install_all "$WEBBOT_HOME" ;;
  init)    cmd_init "$@" ;;
  auth)    cmd_auth ;;
  creds)   cmd_creds "$@" ;;
  run|go)  cmd_run ;;
  flow)    cmd_flow "$@" ;;
  design)  cmd_design "$@" ;;
  setup-audio) cmd_setup_audio ;;
  audio)   cmd_audio "$@" ;;
  speak)   cmd_speak "$@" ;;
  tts)     cmd_tts "$@" ;;
  doctor)  cmd_doctor ;;
  help|-h|--help) usage ;;
  *) echo "ERR: unknown subcommand '$SUB'" >&2; usage; exit 1 ;;
esac
